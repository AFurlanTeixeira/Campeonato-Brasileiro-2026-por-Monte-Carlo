# =============================================================================
# Variáveis de ambiente — copie este arquivo para .env e ajuste os valores.
# O arquivo .env está no .gitignore.
# Nenhuma delas é obrigatória: os scripts têm defaults sensatos via argparse;
# o .env serve só pra quem preferir fixar esses valores sem passar flag toda vez.
# =============================================================================

# -----------------------------------------------------------------------------
# Simulação Monte Carlo
# -----------------------------------------------------------------------------
# Número de repetições da simulação da temporada (quanto maior, mais preciso
# e mais lento). Usado por scripts/run_simulation.py quando --n-simulacoes
# não é passado.
N_SIMULACOES=10000

# Seed do gerador de números aleatórios, para resultados reproduzíveis entre
# execuções e entre integrantes do grupo.
RANDOM_SEED=42

# -----------------------------------------------------------------------------
# Dados
# -----------------------------------------------------------------------------
# Caminho do CSV com os jogos do campeonato.
DATA_PATH=data/raw/brasileirao_2026.csv
