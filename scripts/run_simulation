#!/usr/bin/env python3
"""CLI para rodar a simulação Monte Carlo completa da temporada.

Exemplo:
    python scripts/run_simulation.py --n-simulacoes 10000 --seed 42

Defaults vêm de variáveis de ambiente (ver `.env.example`) quando não
passados via flag.
"""

from __future__ import annotations

import argparse
import os

import numpy as np

from brasileirao_mc import dados, estimativas, simulacao, classificacao


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--data-path",
        default=os.environ.get("DATA_PATH", "data/raw/brasileirao_2026.csv"),
        help="Caminho do CSV de jogos.",
    )
    parser.add_argument(
        "--n-simulacoes",
        type=int,
        default=int(os.environ.get("N_SIMULACOES", 10_000)),
        help="Número de repetições da simulação Monte Carlo.",
    )
    parser.add_argument(
        "--seed",
        type=int,
        default=int(os.environ.get("RANDOM_SEED", 42)),
        help="Seed do gerador de números aleatórios.",
    )
    return parser.parse_args()


def main() -> None:
    args = parse_args()
    rng = np.random.default_rng(args.seed)

    jogos = dados.carregar_jogos(args.data_path)
    disputados = dados.jogos_disputados(jogos)
    pendentes = dados.jogos_pendentes(jogos)

    print(f"Jogos disputados: {len(disputados)} | pendentes: {len(pendentes)}")

    parametros = estimativas.estimar_parametros(disputados)

    resultados = []
    for _ in range(args.n_simulacoes):
        temporada_simulada = simulacao.simular_temporada(pendentes, parametros, rng)
        completa = ... # TODO(grupo): concatenar `disputados` + `temporada_simulada`
        tabela_final = classificacao.calcular_classificacao(completa)
        resultados.append(tabela_final)

    # TODO(grupo): agregar `resultados` (lista de tabelas, uma por simulação)
    # para responder às perguntas em `docs/respostas.md` — ex.: proporção de
    # simulações em que cada time termina na posição 1 (probabilidade de
    # título), últimas 4 posições (probabilidade de rebaixamento), etc.


if __name__ == "__main__":
    main()
